# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Secrets. This repo is public: the manifest signing key must never land here.
# Real values live in the environment or on the host, never in git.
.env
.env.*
!.env.example
*.pem
*.key

# The database. This repo is public and the DB holds beacon_tokens.source_ip —
# the only personal data in the system. Committing one would publish raw IP
# addresses that the retention purge exists to remove. The -wal and -shm
# sidecars carry the same rows, so they are excluded too.
*.db
*.db-wal
*.db-shm
*.sqlite3

# macOS
.DS_Store
